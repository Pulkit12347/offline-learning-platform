DATABASE_URL=mysql+pymysql://user:password@localhost:3306/offline_learning
CORS_ORIGINS=["http://localhost:5173"]

# Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# One-time passcodes
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Admin access: the user who registers with this email becomes an admin.
ADMIN_EMAIL=admin@example.com

# SMTP email (for OTP delivery).
# For Gmail: create a 16-digit App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-digit-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=ConceptFlow
